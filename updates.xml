<?xml version="1.0" encoding="utf-8"?>
<updates>
	<!--
		Per-version update entries for the NielBuys/joomla-cms-v3 fork.
		Referenced by list.xml (detailsurl). Served at:
		https://raw.githubusercontent.com/NielBuys/joomla-cms-v3/3.10-dev/updates.xml

		Per release: add a new <update> block, bump <version> and the <downloadurl>
		(the Update Package asset on that release), then push. Highest matching <version> wins.
		Integrity hashes are intentionally omitted (downloads are over HTTPS); add
		<sha256>/<sha384> here later if you want, computed from the uploaded asset.
	-->
	<update>
		<name>Joomla! CMS (NielBuys fork)</name>
		<description>Joomla 3.11.14 - community-maintained fork with backported security fixes</description>
		<element>joomla</element>
		<type>file</type>
		<version>3.11.14</version>
		<infourl title="Joomla 3.11.14 release notes">https://github.com/NielBuys/joomla-cms-v3/releases/tag/3.11.14</infourl>
		<downloads>
			<downloadurl type="full" format="zip">https://github.com/NielBuys/joomla-cms-v3/releases/download/3.11.14/Joomla_3.11.14-Stable-Update_Package.zip</downloadurl>
		</downloads>
		<tags>
			<tag>stable</tag>
		</tags>
		<maintainer>Niel Buys</maintainer>
		<maintainerurl>https://github.com/NielBuys/joomla-cms-v3</maintainerurl>
		<targetplatform name="joomla" version="3.[0-9]+"/>
		<php_minimum>7.2.5</php_minimum>
	</update>
</updates>
